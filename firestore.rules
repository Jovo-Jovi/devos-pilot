rules_version = '2';

// OD-11, docs/DATA_MODEL.md §12: Firestore is read on the server only, with the admin SDK, which
// these rules do not govern. Every client is refused, for every document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
