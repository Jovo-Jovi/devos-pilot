{
  "$comment": "Dev OS automated cycle configuration (OD-03, OD-05). Changing a model id is a D-row.",
  "project": "PILOT",
  "base_branch": "main",
  "branch_prefix": "task/",
  "max_attempts": 3,
  "builder": {
    "cli": "agent",
    "model": "grok-4.7-high",
    "timeout_minutes": 75,
    "model_family": "grok-4.7",
    "default_effort": "high",
    "effort_by_risk": {
      "1": "medium",
      "2": "high",
      "3": "high"
    },
    "effort_note": "The reviewer sets 'Effort: low|medium|high|xhigh' and 'Fast: yes|no' in each fence header; scripts/devos/builder-model.mjs turns that into a Cursor model id (grok-4.7-<effort>[-fast]) and checks it against `agent models`, falling back to `model`.",
    "model_note": "Cursor documents only the family id grok-4.7 (default effort high, Fast the default speed on Pro). The effort/fast ids the CLI accepts come from `agent models` on your account; each run records the Grok ids it offered in the PR's runner evidence."
  },
  "reviewer": {
    "cli": "claude",
    "model_by_risk": {
      "1": "claude-sonnet-5-5",
      "2": "claude-sonnet-5-5",
      "3": "claude-opus-5-5"
    },
    "gate_model": "claude-opus-5-5",
    "max_turns": 80,
    "timeout_minutes": 40,
    "effort_by_risk": {
      "1": "high",
      "2": "high",
      "3": "xhigh"
    },
    "gate_effort": "xhigh",
    "intake_effort": "xhigh",
    "fallback_model": "claude-sonnet-5-5",
    "model_note": "Official Claude ids (claude-opus-5-5, claude-sonnet-5-5). Opus 5.5 and Sonnet 5.5 default to medium effort in Claude Code, so the runner always passes --effort. --fallback-model only applies when the primary is overloaded or unavailable, never on usage limits."
  },
  "required_checks": [
    "guards",
    "typecheck",
    "lint",
    "test",
    "build"
  ],
  "optional_checks": [
    "e2e"
  ],
  "surfaces": {
    "builder": {
      "deny": [
        ".github/workflows/devos-*.yml",
        "scripts/devos/**",
        "scripts/guards/**",
        "devos/**",
        "devos.config.json",
        "docs/fences/**",
        "docs/reviews/**",
        "docs/DECISIONS.md",
        "docs/method/DEVOS_FIT.md",
        "docs/method/DEV_OS_V2_REVIEWER.md",
        "CLAUDE.md",
        ".claude/**",
        ".cursor/cli.json",
        ".cursor/hooks.json",
        ".cursor/hooks/**",
        "content/**",
        "vercel.json",
        "docs/design/**",
        "docs/requests/**",
        ".github/ISSUE_TEMPLATE/**"
      ]
    },
    "reviewer": {
      "allow": [
        "docs/reviews/**",
        "docs/fences/**"
      ]
    },
    "ignore": [
      ".devos/**"
    ],
    "intake": {
      "allow": [
        "docs/DECISIONS.md",
        "docs/SCOPE.md",
        "docs/PHASES.md",
        "docs/fences/**",
        "docs/requests/**",
        "docs/DESIGN_SYSTEM.md",
        "docs/CONTENT_MODEL.md",
        "docs/I18N_MODEL.md",
        "docs/SECURITY_MODEL.md",
        "docs/BOUNDARY_MODEL.md",
        "docs/adr/**"
      ]
    },
    "revise": {
      "allow": [
        "docs/fences/**",
        "docs/requests/**"
      ]
    }
  },
  "resume": {
    "inline_wait_max_minutes": 330,
    "default_wait_minutes": 60
  }
}
