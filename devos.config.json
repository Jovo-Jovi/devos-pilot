{
  "$comment": "Dev OS automated cycle configuration (OD-03, OD-05). Changing a model id is a D-row.",
  "project": "PILOT",
  "base_branch": "main",
  "branch_prefix": "task/",
  "max_attempts": 3,
  "builder": {
    "cli": "agent",
    "model": "grok-4.7",
    "effort": "high",
    "effort_note": "Grok 4.7's default effort is high; the Cursor CLI has no effort flag. If `agent models` lists an effort-suffixed id (e.g. grok-4.7-high), put that id in `model`.",
    "timeout_minutes": 75
  },
  "reviewer": {
    "cli": "claude",
    "model_by_risk": { "1": "claude-sonnet-5-5", "2": "claude-sonnet-5-5", "3": "claude-opus-5-5" },
    "gate_model": "claude-opus-5-5",
    "max_turns": 80,
    "timeout_minutes": 40
  },
  "required_checks": ["guards", "typecheck", "lint", "test", "build"],
  "optional_checks": ["e2e"],
  "surfaces": {
    "builder": {
      "deny": [
        ".github/workflows/devos-*.yml",
        "scripts/devos/**",
        "scripts/guards/**",
        "devos/**",
        "devos.config.json",
        "docs/fences/**",
        "docs/reviews/**",
        "docs/DECISIONS.md",
        "docs/method/DEVOS_FIT.md",
        "docs/method/DEV_OS_V2_REVIEWER.md",
        "CLAUDE.md",
        ".claude/**",
        ".cursor/cli.json",
        ".cursor/hooks.json",
        ".cursor/hooks/**",
        "content/**"
      ]
    },
    "reviewer": {
      "allow": ["docs/reviews/**", "docs/fences/**"]
    },
    "ignore": [".devos/**"]
  }
}
